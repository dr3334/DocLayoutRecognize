# 工件是普通 Git 文件，GitHub Download ZIP 也会包含，不联网、不使用宿主 .so。
set(MNN_PREBUILT_ROOT "${ANDROID_OCR_ROOT}/native/mnn-prebuilt" CACHE PATH "内附 MNN Android 运行库")
if(NOT EXISTS "${MNN_PREBUILT_ROOT}/manifest.json")
  message(FATAL_ERROR "缺少内附 MNN 预编译包，请重新获取完整仓库（不需要下载 MNN 源码）")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${MNN_PREBUILT_ROOT}/manifest.json" "${ANDROID_OCR_ROOT}/native/dependencies.json")
file(READ "${MNN_PREBUILT_ROOT}/manifest.json" mnn_manifest)
file(READ "${ANDROID_OCR_ROOT}/native/dependencies.json" native_dependencies)
string(JSON mnn_commit GET "${mnn_manifest}" source commit)
string(JSON expected_mnn_commit GET "${native_dependencies}" mnn commit)
string(JSON mnn_abi GET "${mnn_manifest}" android abi)
string(JSON mnn_min_sdk GET "${mnn_manifest}" android minSdk)
string(JSON mnn_ndk GET "${mnn_manifest}" android ndk)
if(NOT mnn_commit STREQUAL expected_mnn_commit OR NOT ANDROID_ABI STREQUAL mnn_abi)
  message(FATAL_ERROR "预编译 MNN 的版本或 ABI 与项目不符；当前只提供 arm64-v8a")
endif()
file(READ "${CMAKE_ANDROID_NDK}/source.properties" ndk_properties)
string(REGEX MATCH "Pkg.Revision = ([0-9.]+)" ndk_revision_match "${ndk_properties}")
set(actual_ndk "${CMAKE_MATCH_1}")
if(ANDROID_PLATFORM_LEVEL LESS mnn_min_sdk OR NOT actual_ndk STREQUAL mnn_ndk)
  message(FATAL_ERROR "预编译 MNN 需要 API >= ${mnn_min_sdk} 和 NDK ${mnn_ndk}（当前 API ${ANDROID_PLATFORM_LEVEL}, NDK ${actual_ndk}）")
endif()
# 仅在配置构建时检查运行库/头文件，与模型加载时的权重检查无关。
string(JSON mnn_file_count LENGTH "${mnn_manifest}" filesSha256)
math(EXPR mnn_last_file "${mnn_file_count}-1")
foreach(index RANGE ${mnn_last_file})
  string(JSON relative MEMBER "${mnn_manifest}" filesSha256 ${index})
  string(JSON expected GET "${mnn_manifest}" filesSha256 "${relative}")
  if(NOT EXISTS "${MNN_PREBUILT_ROOT}/${relative}")
    message(FATAL_ERROR "内附 MNN 文件缺失：${relative}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MNN_PREBUILT_ROOT}/${relative}")
  file(SHA256 "${MNN_PREBUILT_ROOT}/${relative}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "内附 MNN 文件校验失败：${relative}")
  endif()
endforeach()
foreach(name MNN MNN_Express MNNOpenCV llm)
  add_library(${name} SHARED IMPORTED GLOBAL)
  set_target_properties(${name} PROPERTIES
    IMPORTED_LOCATION "${MNN_PREBUILT_ROOT}/lib/${ANDROID_ABI}/lib${name}.so"
    INTERFACE_INCLUDE_DIRECTORIES "${MNN_PREBUILT_ROOT}/include")
endforeach()
# 显式表达链接依赖；app/build.gradle 的 jniLibs 目录负责打包四个库。
target_link_libraries(MNN_Express INTERFACE MNN)
target_link_libraries(MNNOpenCV INTERFACE MNN_Express)
target_link_libraries(llm INTERFACE MNNOpenCV)
set(DOCOCR_MNN_ROOT "${MNN_PREBUILT_ROOT}" CACHE PATH "" FORCE)
set(DOCOCR_MNN_INCLUDE "${MNN_PREBUILT_ROOT}/include" CACHE PATH "" FORCE)
set(DOCOCR_LLM_INCLUDE "${MNN_PREBUILT_ROOT}/include" CACHE PATH "" FORCE)
set(DOCOCR_MNN_LIBRARY MNN CACHE STRING "" FORCE)
set(DOCOCR_LLM_LIBRARY llm CACHE STRING "" FORCE)
message(STATUS "使用内附 MNN ${mnn_commit} (${mnn_abi})，不编译 MNN 源码")
